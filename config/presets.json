{
  "$comment": "The Explore canon. Every preset is also a worked example of the Build grammar, so each must be expressible as {dataset, measure, dimension, period, filters}. If a preset cannot be expressed in the builder vocabulary, either extend the vocabulary or drop the preset. A chart whose dataset has a definition in dimensions.json renders that definition.",
  "evergreen_test": "Would this chart still be worth showing in 2035? If the title names a specific scheme, brand or year, it fails and belongs in the events layer instead.",
  "groups": [
    {
      "id": "powertrain",
      "label": "How vehicles are powered",
      "presets": [
        {
          "id": "powertrain-mix",
          "question": "How has each powertrain's share of new registrations changed?",
          "dataset": "registrations_surviving",
          "measure": "share",
          "dimension": "powertrain",
          "period": "all",
          "filters": [
            {
              "segment_group": "Light passenger"
            }
          ],
          "events": true
        },
        {
          "id": "fleet-catchup",
          "question": "How far behind the market is the fleet?",
          "shape_override": "trend",
          "series": [
            {
              "dataset": "registrations_surviving",
              "measure": "share",
              "dimension": "powertrain",
              "label": "Share of each month's registrations still on the road"
            },
            {
              "dataset": "fleet",
              "measure": "share",
              "dimension": "powertrain",
              "label": "Share of vehicles on the road"
            }
          ],
          "period": "all",
          "shade_gap": true,
          "note": "The gap is how long a change in what people buy takes to reach the road."
        }
      ]
    },
    {
      "id": "origin",
      "label": "Where our vehicles come from",
      "presets": [
        {
          "id": "brand-owner-origin",
          "question": "Which countries own the brands New Zealanders buy?",
          "dataset": "registrations_surviving",
          "measure": "share",
          "dimension": "owner_country",
          "period": "all",
          "events": true
        },
        {
          "id": "built-in",
          "question": "Where are New Zealand's vehicles actually built?",
          "dataset": "registrations_surviving",
          "measure": "share",
          "dimension": "built_in",
          "period": "all",
          "events": true
        },
        {
          "id": "brand-vs-built",
          "question": "Japanese brands or Japanese-built? The gap.",
          "shape_override": "trend",
          "series": [
            {
              "dataset": "registrations_surviving",
              "measure": "share",
              "dimension": "owner_country",
              "filter_value": "Japan",
              "label": "Japanese-owned brands"
            },
            {
              "dataset": "registrations_surviving",
              "measure": "share",
              "dimension": "built_in",
              "filter_value": "JAPAN",
              "label": "Built in Japan"
            }
          ],
          "period": "all",
          "shade_gap": true,
          "note": "Brand share can hold steady while production moves country. This is the chart nobody publishes."
        },
        {
          "id": "used-import-source",
          "question": "Where do our used imports come from?",
          "dataset": "used_imports",
          "measure": "share",
          "dimension": "imported_from",
          "period": "all"
        }
      ]
    },
    {
      "id": "market",
      "label": "How the market is structured",
      "presets": [
        {
          "id": "new-vs-used",
          "question": "New or second-hand? The balance over time.",
          "dataset": "registrations_surviving",
          "measure": "share",
          "dimension": "import_status",
          "period": "all",
          "events": true
        },
        {
          "id": "volume-trend",
          "question": "How many vehicles are being registered?",
          "dataset": "registrations_flow",
          "measure": "rolling_12m",
          "dimension": null,
          "period": "all",
          "events": true,
          "note": "Every first registration in each month, including vehicles since scrapped. Counts of vehicles still on the road would shrink the past and overstate growth."
        },
        {
          "id": "brand-share",
          "question": "Which brands are gaining and losing ground?",
          "dataset": "registrations_surviving",
          "measure": "share",
          "dimension": "make",
          "period": "10y",
          "top_n": 10
        },
        {
          "id": "concentration",
          "question": "Is the market getting more crowded?",
          "shape_override": "trend",
          "derived": "top_5_share",
          "dataset": "registrations_surviving",
          "dimension": "make",
          "period": "all",
          "note": "The combined share of the five largest brands. A falling line means more brands competing."
        },
        {
          "id": "model-league",
          "question": "What are the best-selling models right now?",
          "dataset": "registrations_surviving",
          "measure": "count",
          "dimension": "model",
          "period": "latest_month",
          "top_n": 20,
          "show_rank_delta": true
        },
        {
          "id": "ownership-churn",
          "question": "How often do vehicles change hands?",
          "dataset": "ownership_changes",
          "measure": "rolling_12m",
          "dimension": null,
          "period": "all"
        }
      ]
    },
    {
      "id": "new_or_old",
      "label": "New or old?",
      "presets": [
        {
          "id": "age-distribution-moving-hole",
          "question": "Which vehicle years can't we import any more?",
          "dataset": "used_imports",
          "measure": "share",
          "dimension": "age_at_registration_band",
          "period": "all",
          "shape_override": "distribution",
          "animate_by": "year",
          "events": true,
          "note": "Since the Japanese emissions-code rule of April 2024, the oldest vehicle year arriving in volume has been 2012, as at the 2026 snapshots. The closed band is fixed in vehicle year, so the cutoff's age rises by one each year and the gap moves rightward through this chart."
        },
        {
          "id": "import-age-trend",
          "question": "Are our used imports getting younger or older?",
          "derived": "median_import_age",
          "dataset": "used_imports",
          "period": "all",
          "events": true
        },
        {
          "id": "used-import-age",
          "question": "How old are used imports when they arrive?",
          "dataset": "used_imports",
          "measure": "count",
          "dimension": "age_at_registration_band",
          "period": "latest_year",
          "shape_override": "distribution",
          "note": "Most arrive aged 9 to 13. Ages 3 and 4 are each only 1 to 3 percent of arrivals."
        },
        {
          "id": "regional-import-age",
          "question": "Which regions buy the oldest second-hand imports?",
          "derived": "median_import_age",
          "dataset": "used_imports",
          "dimension": "region",
          "period": "latest_year",
          "shape_override": "geo",
          "note": "Median age at first NZ registration of used imports, by the region where the owner lives now."
        },
        {
          "id": "pipeline-lag",
          "question": "How long before a new model shows up second-hand?",
          "derived": "pipeline_lag",
          "dataset": "registrations_surviving",
          "dimension": "make",
          "period": "all",
          "top_n": 15,
          "note": "Derived from first-appearance detection, not a curated launch list. See docs/MODEL_AND_AGE.md."
        }
      ]
    },
    {
      "id": "fleet",
      "label": "The fleet on the road",
      "presets": [
        {
          "id": "fleet-age",
          "question": "How old is New Zealand's vehicle fleet?",
          "dataset": "fleet",
          "measure": "share",
          "dimension": "vehicle_year_band",
          "period": "all",
          "shape_override": "distribution"
        },
        {
          "id": "cohort-survival",
          "question": "How long do vehicles stay on the road?",
          "derived": "cohort_survival",
          "dataset": "fleet",
          "period": "all",
          "note": "Of the vehicles first registered in a given year, what share is still registered N years later."
        }
      ]
    },
    {
      "id": "characteristics",
      "label": "What we're buying",
      "presets": [
        {
          "id": "segment-mix",
          "question": "Cars, utes, vans or trucks?",
          "dataset": "registrations_surviving",
          "measure": "share",
          "dimension": "segment",
          "period": "all",
          "events": true,
          "note": "The register records most SUVs as station wagons, so they count as cars here."
        },
        {
          "id": "engine-size",
          "question": "Are engines getting bigger or disappearing?",
          "dataset": "registrations_surviving",
          "measure": "share",
          "dimension": "engine_size_band",
          "period": "all",
          "shape_override": "distribution"
        },
        {
          "id": "emissions-trend",
          "question": "Are new registrations getting cleaner?",
          "derived": "mean_co2",
          "dataset": "registrations_surviving",
          "period": "all",
          "events": true
        }
      ]
    },
    {
      "id": "geography",
      "label": "Where in the country",
      "presets": [
        {
          "id": "regional-volume",
          "question": "Which regions register the most vehicles per person?",
          "derived": "per_capita",
          "dataset": "registrations_surviving",
          "dimension": "region",
          "period": "latest_year",
          "shape_override": "geo"
        },
        {
          "id": "regional-powertrain",
          "question": "Which parts of the country are electrifying fastest?",
          "dataset": "registrations_surviving",
          "measure": "share",
          "dimension": "region",
          "filters": [
            {
              "powertrain": "BEV"
            }
          ],
          "period": "latest_year",
          "shape_override": "geo"
        },
        {
          "id": "regional-age",
          "question": "Where are the oldest vehicles?",
          "derived": "mean_fleet_age",
          "dataset": "fleet",
          "dimension": "region",
          "period": "latest_month",
          "shape_override": "geo"
        }
      ]
    }
  ]
}
