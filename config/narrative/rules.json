{
  "$comment": "What the sentences the site writes about the data may contain (CLAUDE.md invariant 8: a template names no domain value, figure or year, says what the data shows and never why). pipeline/tests/test_site_config.py holds every new template in config to this file. banned_words is the linted list of causal and judgement words. placeholders names what the code fills for each kind of template; an entry ending .* allows any path beneath it.",
  "banned_words": [
    "because",
    "due to",
    "caused",
    "causing",
    "owing",
    "thanks to",
    "as a result",
    "therefore",
    "surged",
    "soared",
    "plunged",
    "slumped",
    "boomed",
    "crashed",
    "only",
    "just",
    "despite",
    "unfortunately",
    "fortunately",
    "dramatic",
    "sharp",
    "sharply",
    "huge",
    "massive"
  ],
  "ordinary_words": ["Car"],
  "$ordinary_words_comment": "Names from the reference files that are also plain words in a sentence and so may appear in a template; matched whole, ignoring case, with a plural. pipeline/tests/test_site_config.py fails a template that names any other value or label, however short. Car: the segment value is also the plain word the long-run dataset (Stats NZ's cars and station wagons, its own class) and the cars-still-registered chart use for what they count, in their answer, unit and caveat sentences.",
  "filters": ["pct", "month", "date"],
  "placeholders": {
    "answer": ["month", "count", "prior_month", "prior_count", "change"],
    "words": ["months", "window", "vehicles", "count"],
    "phrases": ["change", "prior_month", "prior_count", "span", "end", "current", "prior_window", "prior", "asked", "shown", "month", "from", "to", "count", "label", "value", "months", "window", "trailing", "all_time", "trailing_high", "all_time_high", "hybrid", "vehicles", "floor", "threshold", "picked", "field", "leader", "leaders", "names", "list", "column", "mark", "reason", "counted", "row", "row_field", "column_field", "rest", "minimum"],
    "refresh_notice": ["month", "date"],
    "notices": ["asked", "shown", "dataset", "field", "pinned", "date", "latest", "kind"],
    "canvas": ["field", "other", "dataset", "measure", "zone", "type", "wanted", "reason", "query", "shown", "number", "months", "date", "top_n", "name"],
    "comparison": ["count", "span", "from", "to", "date", "definition", "source", "added_up_from", "dataset", "conditions", "note", "field", "values", "measure", "host"],
    "latest_month": ["month", "prior_month", "counted", "change", "prior_count", "prior", "name", "names", "field", "share", "points", "minimum", "heading", "view", "parts", "count", "window", "start", "end", "items", "label", "months"],
    "answer_pages": ["name", "brand", "span", "counted", "change", "prior_count", "prior", "window", "rank", "of", "share", "heading", "minimum", "view", "parts", "count", "field"],
    "display_names": [],
    "line": [],
    "unit_note": ["base"],
    "caveat": [],
    "table_label": ["from", "to"],
    "chart_sentence": ["counted", "change", "prior_count", "prior", "name", "names", "label", "share", "points", "prior_share", "month", "prior_month", "recent", "months", "field", "period", "from", "to", "sentence"],
    "note": ["manifest.*", "dataset.*", "measure.*", "dimension.*", "words.*"]
  }
}
