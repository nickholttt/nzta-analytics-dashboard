# Cloudflare Pages applies this file from the output folder (its documented _headers format; nothing is deployed yet, so
# this has not been seen working). Every file under /_astro has a content hash in its name, so a browser may keep one for
# a year and never ask again. The data files and pages keep the default, which makes the browser check each visit.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
