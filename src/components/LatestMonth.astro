---
// The latest month: the front page's first section, an answer to what happened in the newest month (config/latest_month.json). It is worked out
// when the site is built from the published slices (src/lib/latestMonthBuild.ts) and drawn as plain HTML with no script: each block's chart is bars
// in a table, so the figures are the chart's own text, and each block opens its question in the canvas. Where a block has views (new vehicles, used
// imports, all), they sit behind one switch that needs no script (src/components/ViewSwitch.astro). Where the build cannot give the section
// (the dataset is not built, its files are not there) nothing is drawn, and the page is as it was.
import "../styles/latest-month.css";
import manifest from "../../public/data/manifest.json";
import type { Manifest } from "../lib/data";
import { latestMonthSection } from "../lib/latestMonthBuild";
import { latestConfig } from "../lib/latestMonth";
import type { BlockView } from "../lib/latestMonth";
import { answerConfig } from "../lib/answerPages";
import { builtAnswerSite } from "../lib/answerSite";
import { readPublished } from "../lib/publishedFiles.mjs";
import LatestTable from "./LatestTable.astro";
import CutNav from "./CutNav.astro";
import PeriodTable from "./PeriodTable.astro";
import ViewSwitch from "./ViewSwitch.astro";

// The published files are read from the folder the site is built from (src/lib/publishedFiles.mjs).
const view = await latestMonthSection(manifest as unknown as Manifest, readPublished);
const answer = view?.blocks.find((b) => b.kind === "total");
const blocks = view?.blocks.filter((b) => b.kind !== "total") ?? [];
const heading = (b: BlockView) => `lm-${b.id}`;
// A name in a table that has a page of its own (src/lib/answerPages.ts) links to it. The page is found by the name the table shows, for the field the block
// is about; a name two pages share has no link, so a link never opens the other's page.
const answers = await builtAnswerSite();
const pageOf = (b: BlockView) => (name: string): string | undefined => {
  if (latestConfig.dataset !== answerConfig.dataset) return undefined;
  const dimension = latestConfig.blocks.find((x) => x.id === b.id)?.dimension;
  const kind = dimension === answerConfig.brand.dimension ? "brand" : dimension === answerConfig.model.dimension ? "model" : undefined;
  return (kind && answers?.byLabel[kind].get(name)) || undefined;
};
// A split's segments, from darkest to lightest and back, so neighbours differ; a swatch beside each name repeats its colour.
const SEGMENTS = [6, 3, 5, 2, 4];
const colour = (i: number) => `--c:var(--scale-${SEGMENTS[i % SEGMENTS.length]})`;
// The blocks with views are drawn under the switch, the others above it.
const plain = view?.switch ? blocks.filter((b) => !b.views) : blocks;
const viewed = view?.switch ? blocks.filter((b) => b.views) : [];
---

{
  view && answer && (
    <section class="lm" aria-labelledby="lm-heading">
      <div class="section-head">
        <h2 class="section-title" id="lm-heading">{view.heading}</h2>
      </div>
      <p class="meta lm-intro">{view.intro}</p>
      <div class="lm-answer">
        <p class="lm-figure" aria-hidden="true">{answer.figure}</p>
        <p class="lm-sentence">{answer.sentences[0]}</p>
        {answer.parts && <p class="lm-sentence">{answer.parts}</p>}
        <p class="lm-links">
          <a class="starter-open" href={answer.canvas} aria-label={answer.canvasLabel}>{view.labels.canvas}</a>
          <a href={answer.definition}>{view.labels.definition}</a>
        </p>
      </div>
      {view.byPeriod && <PeriodTable table={view.byPeriod} id="lm-periods" noComparison={view.labels.noComparison} newEntry={view.labels.newEntry ?? ""} />}
      <ul class="lm-blocks">
        {plain.map((b) => (
          <li>
            <article class="starter lm-block" aria-labelledby={heading(b)}>
              <h3 class="lm-title" id={heading(b)}>{b.heading}</h3>
              <LatestTable kind={b.kind} title={{ id: heading(b) }} panel={b} definition={b.definition} hiddenLink={b.hiddenLink} labels={view.labels} pageOf={pageOf(b)} colour={colour} />
            </article>
          </li>
        ))}
      </ul>
      {
        view.switch && viewed.length > 0 && (
          <ViewSwitch id="lm-view" legend={view.switch.legend} note={view.switch.note} labels={view.switch.labels} period={view.switch.period}>
            {answers?.cutNav && <CutNav nav={answers.cutNav} onAll />}
            <ul class="lm-blocks">
              {viewed.map((b) => (
                <li>
                  <article class="starter lm-block" aria-labelledby={heading(b)}>
                    <h3 class="lm-title" id={heading(b)}>{b.heading}</h3>
                    {(view.switch.period && b.windowed ? b.windowed : (b.views ?? [])).map((p, i) => (
                      <div class="vs-panel" data-view={p.view ?? i} data-win={p.win === undefined ? undefined : `w${p.win}`} data-win-default={p.win !== undefined && p.win === view.switch?.period?.checked ? "" : undefined}>
                        <h4 class="vs-view">{p.label}</h4>
                        <LatestTable kind={b.kind} title={{ label: p.label }} panel={p} definition={b.definition} hiddenLink={b.hiddenLink} labels={view.labels} pageOf={pageOf(b)} colour={colour} />
                      </div>
                    ))}
                  </article>
                </li>
              ))}
            </ul>
          </ViewSwitch>
        )
      }
      <p class="meta lm-source">
        {[view.provenance.source, view.provenance.snapshot].filter(Boolean).join(" ")} <a href={view.sourceLink.href}>{view.sourceLink.text}</a>
      </p>
      <p class="meta lm-source">{view.caveat.text} <a href={view.caveat.href}>{view.caveat.link}</a></p>
    </section>
  )
}
