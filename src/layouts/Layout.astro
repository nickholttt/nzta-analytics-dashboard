---
import "../styles/site.css";
import manifest from "../../public/data/manifest.json";
import { INTERNAL_PAGES } from "../lib/site";
import siteDoc from "../../config/site.json";
import { attribution } from "../lib/siteCopy";
import { bootTheme } from "../lib/themeChoice";
import RefreshNotice from "../components/RefreshNotice.astro";
import { pageMeta, withSuffix, type OwnWords, type PageId } from "./pageMeta";
import { builtAnswerSite } from "../lib/answerSite";

interface Props {
  title: string;
  activeNav?: Exclude<PageId, "not_found">;
  // The page's words for the head (config/site.json, meta.pages) when it is not one of the navigation's pages, such as the page-not-found page.
  meta?: PageId;
  // The page's own title and description, for a generated page that shares its kind's entry in config/site.json (meta) and its card.
  own?: OwnWords;
  // Internal pages (D-028) stay out of search engines and out of the main navigation.
  noindex?: boolean;
  // The canvas page: wider than a reading page, with its own tokens (src/styles/canvas.css).
  wide?: boolean;
}

const { title, activeNav, meta, own, noindex = false, wide = false } = Astro.props;

// The head's words come from config, keyed by the page. A page that is searched for and has none is a build error, not a page with no description.
const id = meta ?? activeNav;
if (!id && !noindex) throw new Error(`The page "${title}" names no entry of config/site.json meta.pages (activeNav or meta), so it would have no description or social card.`);
const head = id ? pageMeta(id, { pathname: Astro.url.pathname, noindex, own }) : undefined;

// A footer link that leads to the answer pages is drawn only where this build has them: a link to a page that is not there is worse than none.
const hasAnswerPages = (await builtAnswerSite())?.index !== undefined;
const footerLinks = siteDoc.footer_links.filter((link) => !("when" in link) || (link.when === "answer_pages" && hasAnswerPages));

const snapshot = new Intl.DateTimeFormat("en-NZ", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(
  new Date(`${manifest.latest_snapshot}T00:00:00Z`),
);
---

<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {/* The visitor's light or dark choice, applied before the page is drawn so it never flashes the other one (src/lib/themeChoice.ts). */}
    <script is:inline set:html={`(${bootTheme})(${JSON.stringify(siteDoc.theme.storage_key).replace(/</g, "\\u003c")})`} />
    <title>{head?.title ?? withSuffix(title)}</title>
    {noindex && <meta name="robots" content="noindex" />}
    {head && head.tags.map((tag) => (tag.attribute === "name" ? <meta name={tag.key} content={tag.content} /> : <meta property={tag.key} content={tag.content} />))}
    {head?.canonical && <link rel="canonical" href={head.canonical} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{siteDoc.skip_link}</a>
    <div class:list={["page", { "page-canvas": wide }]}>
      <header class="site-bar">
        <p class="eyebrow">Snapshot {snapshot}</p>
        <nav class="site-nav" aria-label="Main navigation">
          {
            siteDoc.nav.map((link) => (
              <a href={link.href} aria-current={activeNav === link.id ? "page" : undefined}>
                {link.label}
              </a>
            ))
          }
        </nav>
        <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false">
          <span class="theme-toggle-track" aria-hidden="true"></span>
          {siteDoc.theme.toggle}
        </button>
      </header>

      <main id="main">
        <RefreshNotice snapshot={manifest.latest_snapshot} />
        <header class="masthead">
          <slot name="masthead" />
        </header>
        {
          head?.needsScript && (
            <noscript>
              <div class="callout warning" role="note">
                <span class="callout-label">Scripts are off</span>
                {siteDoc.meta.noscript}
              </div>
            </noscript>
          )
        }

        <slot />
      </main>

      <footer class="site-footer">
        <p>{attribution}</p>
        <nav aria-label="About this site">
          {
            footerLinks.map((link) => (
              <a href={link.href} aria-current={activeNav === link.id ? "page" : undefined}>
                {link.label}
              </a>
            ))
          }
        </nav>
        {
          INTERNAL_PAGES && (
            <p class="site-footer-internal">
              Internal: <a href="/status">Chart status</a> · <a href="/sense-check">Sense-check tables</a> (not kept up to date)
            </p>
          )
        }
      </footer>
    </div>
  </body>
</html>
