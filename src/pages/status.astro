---
import Layout from "../layouts/Layout.astro";
import PresetPanel from "../components/PresetPanel";
import ReconciliationStatus from "../components/ReconciliationStatus.astro";
import PresetTriage, { BuildWarnings } from "../components/PresetTriage";
import { presetGroups } from "../lib/config";

// Internal (D-041): every preset, drawn or not, with the diagnostics the Explore page leaves out, and (D-112) what the
// build that made the cube warned about.
---

<Layout title="Chart status" noindex>
  <Fragment slot="masthead">
    <h1>Chart status</h1>
    <p class="standfirst">
      Internal. What the build warned about, every preset in <code>config/presets.json</code>, its authored status, what each
      blocked chart is waiting on, and every chart with its build diagnostics. The Explore page shows only the charts that draw.
    </p>
  </Fragment>

  <section id="warnings" aria-labelledby="warnings-title">
    <div class="section-head">
      <p class="eyebrow">Build</p>
      <h2 class="section-title" id="warnings-title">What the build that made this cube warned about</h2>
    </div>
    <p class="panel-definition">
      The warnings in the cube's <code>manifest.json</code>, as the pipeline wrote them. A warning does not stop a build.
    </p>
    <BuildWarnings client:only="react" />
  </section>

  <ReconciliationStatus />

  <section id="triage">
    <div class="section-head">
      <p class="eyebrow">Canon triage</p>
      <h2 class="section-title">The canon and what each preset waits on</h2>
    </div>
    <p class="panel-definition">
      Authored statuses are cross-checked against what this build actually resolves.
    </p>
    <PresetTriage client:only="react" />
  </section>

  {
    presetGroups.map((g) => (
      <section id={g.id}>
        <div class="section-head">
          <p class="eyebrow">{g.label}</p>
          <h2 class="section-title">{g.title}</h2>
        </div>
        {g.presets.map((p) => (
          <PresetPanel client:only="react" presetId={p.id} audience="internal" />
        ))}
      </section>
    ))
  }
</Layout>
