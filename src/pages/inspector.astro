---
import Layout from "../layouts/Layout.astro";
import { MarketDrilldown } from "../components/MarketDrilldown";
import DataInspector from "../components/DataInspector";
---

<Layout title="Data & Market Inspector" activeNav="inspector">
  <Fragment slot="masthead">
    <h1>Data & Market Inspector</h1>
    <p class="standfirst">
      Twist, wrangle, and drill down into the register data to answer critical automotive industry questions, understand statutory classification vs commercial reality, and explore market dynamics.
    </p>
  </Fragment>

  <MarketDrilldown client:only="react" />

  <hr style="margin: var(--space-6) 0 var(--space-5); border: 0; border-top: 1px solid var(--rule-strong);" />

  <section>
    <h2>Model-Level Statutory Body Type Explorer</h2>
    <p class="meta" style="margin-bottom: var(--space-4);">
      Empirically inspect any of the top 35 vehicle nameplates in New Zealand to verify its statutory physical body type registrations (e.g. RAV4 or Outlander as station wagon) and motive power makeup.
    </p>
    <DataInspector client:only="react" />
  </section>
</Layout>
