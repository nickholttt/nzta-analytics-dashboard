---
// Built to 404.html at the site's root. Cloudflare Pages serves it, with a 404 status, for any address the site does
// not have; without it Pages treats the site as a single-page app and answers every unknown address with Explore and
// a 200, including the internal pages a public build leaves out (D-057).
// The links go only to pages that stay: the canvas is where a chart is made, and the pages that explain the figures and take reports.
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" meta="not_found" noindex>
  <Fragment slot="masthead">
    <h1>Page not found</h1>
    <p class="standfirst">There is no page at this address. It may have been mistyped, or the page may have moved.</p>
  </Fragment>

  <article class="prose">
    <p class="action-link"><a href="/canvas/">Open the canvas to make a chart of your own</a></p>
    <p>You can also:</p>
    <ul class="action-list">
      <li><a href="/">Start from a question</a>, with the charts this site begins with.</li>
      <li><a href="/method/">Read how each figure is counted</a>.</li>
    </ul>
    <p>
      If you reached this page from a link on this site, please tell us on <a href="/feedback/">Feedback and corrections</a>,
      with the address you came from.
    </p>
  </article>
</Layout>
