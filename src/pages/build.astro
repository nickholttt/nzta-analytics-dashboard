---
// Build is the canvas now: a chart there is a Build question under an id of its own. The site is static, so a link to this address cannot be
// answered by the server; the script below opens the canvas with the question the link asked, and the link on the page is for a browser with
// scripts off. What it needs of config is read here and handed to the script as data (src/lib/buildLink.ts, src/lib/buildLinkRules.ts).
import Layout from "../layouts/Layout.astro";
import { buildLinkRules } from "../lib/buildLinkRules";
import { CANVAS_PATH } from "../lib/canvas";
import { buildMoved } from "../lib/siteCopy";
---

<Layout title={buildMoved.title} meta="build" noindex>
  <Fragment slot="masthead">
    <h1>{buildMoved.title}</h1>
    <p class="standfirst">{buildMoved.lead}</p>
  </Fragment>

  <p class="action-link" id="build-moved" data-rules={JSON.stringify(buildLinkRules())} data-path={CANVAS_PATH}>
    <a href={CANVAS_PATH}>{buildMoved.link}</a>
  </p>
</Layout>

<script>
  import { canvasSearchFromBuild } from "../lib/buildLink";

  // The address the canvas opens at: the link's question as a canvas of its own, and the hash kept. Where anything is not as expected the
  // page stays, with its link to the canvas.
  const moved = document.getElementById("build-moved");
  try {
    const rules = JSON.parse(moved?.dataset.rules ?? "");
    window.location.replace(`${moved?.dataset.path}${canvasSearchFromBuild(window.location.search, rules)}${window.location.hash}`);
  } catch {
    // The link on the page goes to the canvas.
  }
</script>
