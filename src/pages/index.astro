---
import Layout from "../layouts/Layout.astro";
import PresetPanel from "../components/PresetPanel";
import { presetGroups } from "../lib/config";
import { presetView, resolvePreset } from "../lib/resolve";
import manifest from "../../public/data/manifest.json";
import type { Manifest } from "../lib/data";

// The Explore page shows what a visitor can read: each group from config/presets.json, holding only
// the presets whose opening view draws against this build. A chart that cannot be drawn, and a group left with none,
// is not shown here; /status lists every preset and what it waits on (D-041).
const groups = presetGroups
  .map((g) => ({ ...g, presets: g.presets.filter((p) => resolvePreset(presetView(p), manifest as Manifest).preventsRender.length === 0) }))
  .filter((g) => g.presets.length > 0);
---

<Layout title="Explore" activeNav="explore">
  <Fragment slot="masthead">
    <h1>New Zealand vehicle registrations</h1>
    <p class="standfirst">
      Where the vehicles we register come from, what powers them, and whether they arrived new. Every figure is drawn from the
      NZTA Motor Vehicle Register.
    </p>
    <nav class="tier-nav" aria-label="Sections on this page" style="margin-top: var(--space-4); display: flex; gap: var(--space-4); flex-wrap: wrap;">
      {groups.map((g) => (
        <a href={`#${g.id}`} class="meta" style="color: var(--ink-2); text-decoration: none; border-bottom: 1px dashed var(--rule-strong);">
          {g.label}
        </a>
      ))}
    </nav>
  </Fragment>

  {
    groups.map((g) => (
      <section id={g.id}>
        <div class="section-head">
          <p class="eyebrow">{g.label}</p>
          <h2 class="section-title">{g.title}</h2>
        </div>
        {g.presets.map((p) => (
          <PresetPanel client:only="react" presetId={p.id} lead={g.lead ?? false} audience="public" />
        ))}
      </section>
    ))
  }
</Layout>
