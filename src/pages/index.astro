---
import Layout from "../layouts/Layout.astro";
import "../styles/starters.css";
import { builderVocabulary } from "../lib/builder";
import { canvasVocabulary, say } from "../lib/canvas";
import { starterViews } from "../lib/starters";
import manifest from "../../public/data/manifest.json";
import type { Manifest } from "../lib/data";

// The front page is the list of the starter canvases (config/starter_canvases.json). Each is a canvas link the canvas page reads like any
// shared one; the list holds only the charts this build can draw, as the canvas will draw them, so no starter opens to an error.
const CANVAS = "/canvas/";
const all = canvasVocabulary(builderVocabulary(manifest as Manifest));
const starters = all.datasets.length > 0 ? starterViews(all, manifest as Manifest, CANVAS) : [];
---

<Layout title="Explore" activeNav="explore">
  <Fragment slot="masthead">
    <h1>New Zealand vehicle registrations</h1>
    <p class="standfirst">
      Where the vehicles we register come from, what powers them, and whether they arrived new. Every figure is drawn from
      NZTA's open data: the Motor Vehicle Register and, where a chart says so, its registrations dashboard.
    </p>
  </Fragment>

  <section aria-labelledby="starters-heading">
    <div class="section-head">
      <h2 class="section-title" id="starters-heading">{say("starters_heading")}</h2>
    </div>
    {
      starters.length > 0 ? (
        <>
          <p class="meta starters-intro">{say("starters_intro")}</p>
          <ul class="starters">
            {starters.map((s) => (
              <li>
                <article class="starter" aria-labelledby={`starter-${s.id}`}>
                  <h3 class="starter-title" id={`starter-${s.id}`}>
                    <a href={s.href}>{s.title}</a>
                  </h3>
                  <p class="starter-description">{s.description}</p>
                  <div class="starter-holds">
                    <p class="eyebrow" id={`holds-${s.id}`}>{say("starter_holds")}</p>
                    <ul class="starter-charts" aria-labelledby={`holds-${s.id}`}>
                      {s.charts.map((title) => (
                        <li>{title}</li>
                      ))}
                    </ul>
                  </div>
                  <a class="starter-open" href={s.href} aria-label={say("starter_open_named", { name: s.title })}>
                    {say("starter_open")}
                  </a>
                </article>
              </li>
            ))}
          </ul>
        </>
      ) : (
        <div class="callout blocked">
          <span class="callout-label">{say("starters_none_label")}</span>
          {say("starters_none")}
        </div>
      )
    }
  </section>

  <section aria-labelledby="empty-heading">
    <div class="section-head">
      <h2 class="section-title" id="empty-heading">{say("starter_empty_heading")}</h2>
    </div>
    <div class="starters-empty">
      <a class="starters-empty-link" href={CANVAS}>{say("starter_empty")}</a>
      <p>{say("starter_empty_help")}</p>
    </div>
  </section>
</Layout>
