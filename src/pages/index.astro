---
import "../styles/site.css";
import PresetPanel from "../components/PresetPanel";
import PresetTriage from "../components/PresetTriage";
import manifest from "../../public/data/manifest.json";

// Which presets this local reference page draws. Everything else about each chart comes from config/.
// The triage table below covers the whole canon, drawn or not. This page is a styling reference, not
// the Explore page: the tiers come later.
const sections = [
  { id: "launch", eyebrow: "Launch charts", title: "The shape of the market", lead: true, presets: ["brand-owner-origin", "powertrain-mix", "new-vs-used"] },
  {
    id: "live",
    eyebrow: "Other live charts",
    title: "Everything else the cube can draw",
    lead: false,
    presets: ["brand-share", "parent-group-share", "concentration", "built-in", "segment-mix", "engine-size"],
  },
];

const snapshot = new Intl.DateTimeFormat("en-NZ", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(
  new Date(`${manifest.latest_snapshot}T00:00:00Z`),
);
---

<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>NZ vehicle registrations · reference charts</title>
  </head>
  <body>
    <main class="page">
      <header class="masthead">
        <p class="eyebrow">Reference build · snapshot {snapshot}</p>
        <h1>New Zealand vehicle registrations</h1>
        <p class="standfirst">
          Where the vehicles we register come from, what powers them, and whether they arrived new. Every figure is drawn from the
          NZTA Motor Vehicle Register.
        </p>
      </header>
      {
        sections.map((s) => (
          <section id={s.id}>
            <div class="section-head">
              <p class="eyebrow">{s.eyebrow}</p>
              <h2 class="section-title">{s.title}</h2>
            </div>
            {s.presets.map((id) => (
              <PresetPanel client:only="react" presetId={id} lead={s.lead} />
            ))}
          </section>
        ))
      }
      <section id="triage">
        <div class="section-head">
          <p class="eyebrow">Canon</p>
          <h2 class="section-title">Every preset and what it waits on</h2>
        </div>
        <p class="panel-definition">
          Every preset in <code>config/presets.json</code>, its authored status, and what each one that cannot render yet is waiting on.
          Authored statuses are cross-checked against what this build actually resolves.
        </p>
        <PresetTriage client:only="react" />
      </section>
    </main>
  </body>
</html>
